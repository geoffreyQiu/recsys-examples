# Reuse all previously built dependencies; rebuild only the KV-cache package.
ARG BASE_IMAGE=hstu-flexkv-minimal:sm120
FROM ${BASE_IMAGE}
ARG BUILD_JOBS=4
ENV TORCH_CUDA_ARCH_LIST=12.0 MAX_JOBS=${BUILD_JOBS} NVCC_THREADS=1
COPY corelib/recsys_kvcache_manager /workspace/recsys-examples/corelib/recsys_kvcache_manager
WORKDIR /workspace/recsys-examples/corelib/recsys_kvcache_manager
# Import/link only: no GPU is needed during this build.
RUN mkdir -p /opt/cachefix-build-driver \
    && ln -s /usr/local/cuda/lib64/stubs/libcuda.so /opt/cachefix-build-driver/libcuda.so.1 \
    && ln -s /usr/local/cuda/lib64/stubs/libnvidia-ml.so /opt/cachefix-build-driver/libnvidia-ml.so.1 \
    && LD_LIBRARY_PATH=/opt/cachefix-build-driver:${LD_LIBRARY_PATH} \
       python -m pip install --no-index --no-build-isolation --no-deps --force-reinstall . \
    && LD_LIBRARY_PATH=/opt/cachefix-build-driver:${LD_LIBRARY_PATH} \
       python -c 'import torch; import kvcache_cpp; assert kvcache_cpp.cache_allocator_stream_ordering == "events_v1"' \
    && rm -rf /opt/cachefix-build-driver
WORKDIR /workspace/recsys-examples/examples/hstu
