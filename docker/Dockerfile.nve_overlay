# syntax=docker/dockerfile:1

# Fast validation image for an NVE-only upgrade. BASE_MAIN_IMAGE must be the
# completed `build` image produced from main by docker/Dockerfile, not the
# base_fbgemm or base_triton dependency image.
ARG BASE_MAIN_IMAGE
FROM ${BASE_MAIN_IMAGE} AS nve_overlay

ARG TARGETPLATFORM

# The main image is already close to Docker's maximum layer depth. Mount the
# build context without copying it into the image, then perform the complete
# overlay in one filesystem layer. FBGEMM HSTU is neither rebuilt nor replaced.
# Runtime verification is intentionally separate from this build.
RUN --mount=type=bind,source=.,target=/tmp/nve-overlay-context \
    set -eux; \
    overlay=/tmp/nve-overlay-context; \
    repo=/workspace/recsys-examples; \
    nve=/workspace/deps/nve; \
    replay_build=${repo}/examples/hstu/inference_aoti/cpp_inference/build; \
    test -d "${nve}"; \
    test -d "${nve}/third_party/NVTX/c/include"; \
    test -f "${replay_build}/CMakeCache.txt"; \
    test -d "${overlay}/third_party/nv-embedding-cache"; \
    test -f "${overlay}/docker/nve_standalone_features.cmake"; \
    mv "${nve}/third_party/NVTX" /tmp/nve-overlay-NVTX; \
    rm -rf "${nve}"; \
    cp -a "${overlay}/third_party/nv-embedding-cache" "${nve}"; \
    mv /tmp/nve-overlay-NVTX "${nve}/third_party/NVTX"; \
    install -m 0644 \
      "${overlay}/docker/nve_standalone_features.cmake" \
      /workspace/deps/nve_standalone_features.cmake; \
    python3 -m pip uninstall -y pynve; \
    if [ "${TARGETPLATFORM}" = "linux/arm64" ]; then \
      avx512_env=""; \
    else \
      avx512_env="PYNVE_DISABLE_AVX512=1"; \
    fi; \
    cd "${nve}"; \
    env \
      CMAKE_TOOLCHAIN_FILE=/workspace/deps/nve_standalone_features.cmake \
      PYNVE_BUILD_DIR=/tmp/pynve-26.07-build \
      PYNVE_WITH_TORCH_BINDINGS=1 \
      TORCH_CUDA_ARCH_LIST="7.5 8.0 8.6 9.0 10.0 12.0" \
      CPLUS_INCLUDE_PATH="$(realpath ./third_party/NVTX/c/include/):${CPLUS_INCLUDE_PATH:-}" \
      ${avx512_env} \
      python3 -m pip install --no-build-isolation --no-deps .; \
    rm -rf /tmp/pynve-26.07-build; \
    install -m 0644 \
      "${overlay}/corelib/dynamicemb/dynamicemb/exportable_tables.py" \
      "${repo}/corelib/dynamicemb/dynamicemb/exportable_tables.py"; \
    install -m 0644 \
      "${overlay}/corelib/dynamicemb/test/test_nve_aoti_export.py" \
      "${repo}/corelib/dynamicemb/test/test_nve_aoti_export.py"; \
    install -m 0644 \
      "${overlay}/examples/hstu/modules/exportable_embedding.py" \
      "${repo}/examples/hstu/modules/exportable_embedding.py"; \
    install -m 0644 \
      "${overlay}/examples/hstu/modules/nve_embeddingcollection.py" \
      "${repo}/examples/hstu/modules/nve_embeddingcollection.py"; \
    install -m 0644 \
      "${overlay}/examples/hstu/inference_aoti/export_inference_gr_ranking.py" \
      "${repo}/examples/hstu/inference_aoti/export_inference_gr_ranking.py"; \
    install -m 0644 \
      "${overlay}/examples/hstu/inference_aoti/export_inference_gr_ranking_kvcache.py" \
      "${repo}/examples/hstu/inference_aoti/export_inference_gr_ranking_kvcache.py"; \
    install -m 0644 \
      "${overlay}/examples/hstu/inference_aoti/cpp_inference/inference_hstu_gr_ranking_exported_model.cpp" \
      "${repo}/examples/hstu/inference_aoti/cpp_inference/inference_hstu_gr_ranking_exported_model.cpp"; \
    install -m 0644 \
      "${overlay}/examples/hstu/inference_aoti/cpp_inference/inference_hstu_gr_ranking_kvcache_exported_model.cpp" \
      "${repo}/examples/hstu/inference_aoti/cpp_inference/inference_hstu_gr_ranking_kvcache_exported_model.cpp"; \
    install -m 0644 \
      "${overlay}/examples/hstu/inference_aoti/README.md" \
      "${repo}/examples/hstu/inference_aoti/README.md"; \
    dynamicemb_dir="$(python3 -c 'import pathlib, dynamicemb; print(pathlib.Path(dynamicemb.__file__).parent)')"; \
    test -d "${dynamicemb_dir}"; \
    install -m 0644 \
      "${repo}/corelib/dynamicemb/dynamicemb/exportable_tables.py" \
      "${dynamicemb_dir}/exportable_tables.py"; \
    touch \
      "${repo}/examples/hstu/inference_aoti/cpp_inference/inference_hstu_gr_ranking_exported_model.cpp" \
      "${repo}/examples/hstu/inference_aoti/cpp_inference/inference_hstu_gr_ranking_kvcache_exported_model.cpp"; \
    cmake --build "${replay_build}" \
      --target \
        inference_hstu_gr_ranking_exported_model \
        inference_hstu_gr_ranking_kvcache_exported_model \
      -j 8; \
    rm -rf "${repo}/examples/hstu/triton_libs/pynve"; \
    mkdir -p "${repo}/examples/hstu/triton_libs/pynve"; \
    cp -a /usr/local/lib/python3.12/dist-packages/pynve/. \
      "${repo}/examples/hstu/triton_libs/pynve/"; \
    rm -rf "${repo}/examples/hstu/inference_aoti/nve_init_hook/build"
